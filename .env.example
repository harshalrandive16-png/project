# ═══════════════════════════════════════════════════════════
# BhoomiSuraksha v5.2 — Environment Template
# Copy this file → .env  and fill real values
# NEVER commit the real .env file
# ═══════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=production

# JWT (MUST be 32+ random chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_HERE

# CORS (comma-separated, no spaces after comma preferred)
ALLOWED_ORIGINS=http://localhost:5000,https://harshalrandive16-png.github.io,https://project-2-wszb.onrender.com

# Fast2SMS (DLT Route 'q' / BulkV2)
FAST2SMS_API_KEY=REPLACE_WITH_YOUR_FAST2SMS_KEY

# Autopilot responder numbers (comma-separated 10-digit)
ALERT_NUMBERS=8237107646,9359010933,9209428310,9529593994,9322719902,8262948340,8766028491

# Geofence / Autopilot tuning
AUTOPILOT_RADIUS_KM=15
AUTOPILOT_COOLDOWN_SEC=300
AUTOPILOT_MAX_RESIDENT_SMS=50

# IoT Sensor HMAC / API Key
SENSOR_API_KEY=REPLACE_WITH_RANDOM_SENSOR_KEY_32CHARS

# Firebase — Option 1: path to key file (local only, never commit the file)
FIREBASE_KEY_PATH=./serviceAccountKey.json

# Firebase — Option 2: full JSON string (preferred on Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"bhoomishuraksh",...}

# AI Keys (optional — fallback rule matrix always works)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# KIRA_API_KEY=